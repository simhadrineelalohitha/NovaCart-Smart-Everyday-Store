# ── Server Configuration ─────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Set DATABASE_URL to use PostgreSQL. Production requires it; local development
# may leave it blank to use the existing SQLite file configured by DB_PATH.
DATABASE_URL=
DB_PATH=./novacart-catalog.db
# Production PostgreSQL verifies TLS certificates unless explicitly disabled.
# Only set PGSSL_REJECT_UNAUTHORIZED=false when your provider requires a custom CA.

# ── JWT Authentication ───────────────────────────────
# Replace with a long random string — e.g. run: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Google OAuth (optional locally; required to enable Continue with Google)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
GOOGLE_SUCCESS_REDIRECT=http://localhost:5000/pages/index.html
